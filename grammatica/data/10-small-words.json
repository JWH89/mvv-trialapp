          ["zorgen **voor**", "take care of"],
          ["vragen **om**", "ask for"],
          ["vragen **naar**", "ask about"],
          ["genieten **van**", "enjoy"],
          ["lijken **op**", "look like"],
          ["klagen **over**", "complain about"],
