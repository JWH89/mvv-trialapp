        {"h": "Time"},
        {"table": {"head": ["word", "use", "example"], "rows": [
          ["om", "clock time", "**om** acht uur"],
          ["op", "days and dates", "**op** maandag, **op** 5 mei"],
          ["in", "months, seasons, years", "**in** mei, **in** de zomer, **in** 2026"],
          ["over", "in (from now)", "**over** twee weken"],
          ["geleden", "ago (after the time)", "twee jaar **geleden**"],
          ["sinds", "since", "**sinds** maart"],
          ["van … tot", "from … until", "**van** negen **tot** vijf"]
        ]}}
      ],
      "mistakes": [
